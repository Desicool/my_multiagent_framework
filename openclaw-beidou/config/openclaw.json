{
  "$schema": "https://openclaw.dev/schemas/openclaw.json",
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789"
      ]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "${DEEPSEEK_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.55,
              "output": 2.19,
              "cacheRead": 0.14,
              "cacheWrite": 0.55
            },
            "contextWindow": 1000000,
            "maxTokens": 32000
          },
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.27,
              "output": 1.1,
              "cacheRead": 0.07,
              "cacheWrite": 0.27
            },
            "contextWindow": 1000000,
            "maxTokens": 16000
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/desico/.openclaw/workspace",
      "sandbox": {
        "mode": "off",
        "scope": "agent",
        "workspaceAccess": "rw",
        "docker": {
          "network": "bridge",
          "env": {
            "HTTP_PROXY": "http://host.docker.internal:7890",
            "HTTPS_PROXY": "http://host.docker.internal:7890",
            "NO_PROXY": "localhost,127.0.0.1,172.17.0.0/16"
          }
        }
      },
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "30m",
        "target": "last"
      }
    },
    "list": [
      {
        "id": "beidou-orch",
        "name": "Beidou Orchestrator",
        "default": true,
        "skills": [
          "beidou-orchestrator"
        ],
        "workspace": "/home/desico/.openclaw/workspace-orch",
        "model": {
          "primary": "deepseek/deepseek-v4-pro"
        },
        "tools": {
          "allow": [
            "exec",
            "read",
            "write",
            "edit",
            "sessions_spawn",
            "sessions_list",
            "sessions_send",
            "session_status"
          ],
          "deny": [
            "browser",
            "canvas"
          ]
        },
        "subagents": {
          "allowAgents": [
            "beidou-pm",
            "beidou-arch",
            "beidou-junior",
            "beidou-test",
            "beidou-deploy",
            "beidou-qa"
          ]
        },
        "sandbox": {
          "mode": "all",
          "scope": "agent",
          "workspaceAccess": "rw"
        }
      },
      {
        "id": "beidou-pm",
        "name": "Beidou Product Manager",
        "skills": [
          "beidou-product-manager"
        ],
        "workspace": "/home/desico/.openclaw/workspace-pm",
        "model": {
