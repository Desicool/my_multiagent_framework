  "channels": {
    "discord": {
      "enabled": true,
      "token": "${DISCORD_BOT_TOKEN}",
      "proxy": "http://127.0.0.1:7891",
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "guilds": {
        "1497969197307793540": {
          "requireMention": false
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "beidou-orch",
      "match": {
        "channel": "discord"
      }
    }
  ],
  "tools": {
    "exec": {
      "host": "sandbox"
    }
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "idle",
      "idleMinutes": 120
    }
  },
  "logging": {
    "level": "info",
    "redactSensitive": "tools"
  },
  "plugins": {
    "entries": {
      "deepseek": {
        "enabled": true
      }
    }
  },
