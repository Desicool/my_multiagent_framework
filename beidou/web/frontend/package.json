    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@vitest/ui": "^3.1.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "dompurify": "^3.2.3",
    "highlight.js": "^11.10.0",
