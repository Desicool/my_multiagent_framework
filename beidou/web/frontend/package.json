{
  "name": "beidou-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "rebuild": "bash scripts/clean-static.sh && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
