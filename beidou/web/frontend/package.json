    "test": "vitest run",
    "bundle-stats": "npx vite-bundle-visualizer"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/typography": "^0.5.15",
